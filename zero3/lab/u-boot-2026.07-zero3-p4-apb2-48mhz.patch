--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -564,0 +565,7 @@
+config SUNXI_ZERO3_P4_48MHZ
+	bool "Experimental Orange Pi Zero 3 P4 APB2 clock"
+	depends on MACH_SUN50I_H616
+	help
+	  Start the shared PLL_PERIPH0 at 576 MHz in SPL and hand off
+	  a 48 MHz APB2 clock to Linux. Use only on a test microSD.
+
--- a/configs/orangepi_zero3_defconfig
+++ b/configs/orangepi_zero3_defconfig
@@ -14,0 +15 @@
+CONFIG_SUNXI_ZERO3_P4_48MHZ=y
@@ -32,0 +34,2 @@
+
+# CONFIG_TOOLS_MKEFICAPSULE is not set
--- a/arch/arm/mach-sunxi/clock_sun50i_h6.c
+++ b/arch/arm/mach-sunxi/clock_sun50i_h6.c
@@ -17,0 +18 @@
+	u32 pll6 = CCM_PLL6_DEFAULT;
@@ -47 +48,5 @@
-	writel(CCM_PLL6_DEFAULT, ccm + CCU_H6_PLL6_CFG);
+	/* H616: 24 MHz * 48 / 2 = 576 MHz, before dependent clocks. */
+	if (IS_ENABLED(CONFIG_SUNXI_ZERO3_P4_48MHZ))
+		pll6 = (pll6 & ~CCM_PLL6_CTRL_N_MASK) |
+		       ((48 - 1) << CCM_PLL6_CTRL_N_SHIFT);
+	writel(pll6, ccm + CCU_H6_PLL6_CFG);
--- a/board/sunxi/board.c
+++ b/board/sunxi/board.c
@@ -12,0 +13 @@
+#include <bootm.h>
@@ -191,0 +193,18 @@
+#if defined(CONFIG_SUNXI_ZERO3_P4_48MHZ) && !defined(CONFIG_XPL_BUILD)
+void board_quiesce_devices(void)
+{
+	void *const ccm = (void *)SUNXI_CCM_BASE;
+
+	if (clock_get_pll6() != 576000000U) {
+		puts("P4 LAB: PLL_PERIPH0 is not at 576 MHz; keeping APB2\n");
+		return;
+	}
+
+	/* Keep the SPL, BL31 and U-Boot console at 24 MHz until handoff. */
+	puts("P4 LAB: switching Linux APB2 to 48 MHz\n");
+	udelay(2000);
+	writel(APB2_CLK_SRC_PLL6 | APB2_CLK_RATE_N_4 | APB2_CLK_RATE_M(3),
+	       ccm + CCU_H6_APB2_CFG);
+}
+#endif
+
